{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index.py?__path=health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=$1"
    }
  ]
}
